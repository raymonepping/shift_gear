# slapd.conf — rendered by entrypoint.sh (@ROOTPW@ = SSHA hash of LDAP_ADMIN_PASSWORD).
include   /etc/openldap/schema/core.schema
include   /etc/openldap/schema/cosine.schema
include   /etc/openldap/schema/inetorgperson.schema
include   /etc/openldap/schema/nis.schema

pidfile   /var/lib/openldap/run/slapd.pid
argsfile  /var/lib/openldap/run/slapd.args

modulepath /usr/lib/openldap
moduleload back_mdb.so

# Passwords set via the password-modify extended op are stored hashed.
password-hash {SSHA}

# Nobody reads passwords; users may change their own; Keycloak binds as the
# admin (read-only federation in Keycloak).
access to attrs=userPassword
  by self write
  by anonymous auth
  by * none
access to *
  by self read
  by users read
  by * none

database  mdb
maxsize   67108864
suffix    "dc=shiftgear,dc=local"
rootdn    "cn=admin,dc=shiftgear,dc=local"
rootpw    @ROOTPW@
directory /var/lib/openldap/data
index     objectClass eq
index     uid,cn,member eq
